{
  "name": "ai-trading-terminal",
  "private": true,
  "version": "0.1.0",
  "description": "AI trading terminal & wealth workspace with Alpaca connectivity and a quant bot framework",
  "scripts": {
    "install:all": "npm install && npm --prefix web install",
    "dev": "node server/index.js",
